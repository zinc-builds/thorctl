{
 "name": "skies",
 "package": "com.skiesofarcadia.recomp",
 "aliases": [
  "skiesofarcadia",
  "soa",
  "arcadia"
 ],
 "category": "recomp",
 "version_checked": "0.94.0-beta",
 "stop_before_write": true,
 "files": {
  "dolphin": {
   "path": "/sdcard/Android/data/com.skiesofarcadia.recomp/files/Config/Dolphin.ini",
   "format": "ini",
   "notes": "Dolphin-style main config plus the port's own [Skies] section. Written by the launcher's settings panel through NativeConfig (layer 1 = base) and saved at each change; Dolphin bools are True/False. Holds [Analytics] ID: do not print or copy it."
  },
  "gfx": {
   "path": "/sdcard/Android/data/com.skiesofarcadia.recomp/files/Config/GFX.ini",
   "format": "ini",
   "notes": "Dolphin graphics config. The app also keeps AspectRatio = 5 and CustomAspectRatioWidth/Height = 16/9 here for its Picture setting: leave those to the app."
  },
  "gcpad": {
   "path": "/sdcard/Android/data/com.skiesofarcadia.recomp/files/Config/GCPadNew.ini",
   "format": "ini",
   "notes": "Controller mapping ([GCPad1] = Android/1/Odin Controller for the Thor's built-in pad) and the port's [SkiesHotkeys] (Menu, Invincible)."
  },
  "game_settings": {
   "path": "/sdcard/Android/data/com.skiesofarcadia.recomp/files/GameSettings/{game}.ini",
   "format": "ini",
   "notes": "Shipped by the app for GEAE8P/GEAP8P/GEAJ8P: [Core] StaticRecompIdlePC and CPUThread. Engine internals: do not edit."
  }
 },
 "per_game": null,
