  "config": {
   "path": "/sdcard/mm3dport/config/config.ini",
   "format": "ini",
   "notes": "Azahar config (ini4j, 'key = value' under [Section]); bools true/false. Same keys as the azahar adapter. The root is /sdcard/mm3dport only after the app switches to shared storage (shared_prefs/dekui-storage.xml shared-v1 = true, needs All files access); before that it is /data/data/io.github.otpr26.dekuifork/files/dekui. Created on first start."
  },
  "presentation": {
   "path": "/sdcard/mm3dport/config/mm3d-local/presentation.json",
   "format": "json",
   "notes": "DekUI's own settings (frame rate mode, FOV, draw distance, gameplay options). JSON object with \"version\": 1 (other versions are refused). Written atomically by the settings screen and shared with the in-game menu. Created on first start."
  }
 },
