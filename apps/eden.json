{
  "name": "eden",
  "package": "dev.eden.eden_emulator",
  "aliases": [
    "switch"
  ],
  "version_checked": "1f6734c",
  "stop_before_write": true,
  "files": {
    "global": {
      "path": "/sdcard/Android/data/dev.eden.eden_emulator/files/config/config.ini",
      "format": "qtini",
      "notes": "All emulator settings. Read once at app process start (and rewritten then); later saves write the in-memory copy over the file, so edit only while the app is stopped. A value takes effect only with key\\default=false next to it. Section names use %20 for spaces ([Data%20Storage]). Stale keys from older versions stay in the file and are ignored."
    },
    "prefs": {
      "path": "/data/data/dev.eden.eden_emulator/shared_prefs/dev.eden.eden_emulator_preferences.xml",
      "format": "prefs",
      "notes": "Game library cache (Games set, LastPlayed/AddedToLibraryTime per ROM URI, sort/view type, FirstApplicationLaunch). No emulator settings. Needs root."
    },
    "installed_driver_meta": {
      "path": "/data/data/dev.eden.eden_emulator/files/gpu_driver/meta.json",
      "format": "json",
      "notes": "Metadata of the driver currently extracted to files/gpu_driver/ (next to its .so). Managed by Eden; read it to see what is installed, do not edit. Select a driver with gpu_driver (driver_path) instead. Needs root."
    }
  },
  "per_game": {
    "path": "/sdcard/Android/data/dev.eden.eden_emulator/files/config/custom/{game}.ini",
    "format": "qtini-game",
    "game_id": "16-digit uppercase hex program (title) ID, e.g. 01001234ABCD0000; it is in most ROM filenames in [brackets] and in the Games set of the prefs file. Homebrew with program ID 0 uses the ROM file name with extension instead.",
    "create": true,
    "notes": "Only settings marked per_game are read from it. To override: key\\use_global=false AND key\\default=false AND key=value (use_global=false with a missing or true \\default resets the setting to the built-in default, not to the global value). To go back to global: key\\use_global=true. Game-list launches load (and create, if missing) this file; launches by intent from a frontend use it only if it already exists. Eden rewrites it whenever it loads it."
  },
