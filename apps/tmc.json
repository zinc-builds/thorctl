      "verified_on_device": true,
      "notes": "Path to a .glslp preset; empty = none. Needs render_backend gpu."
    },
    "target_fps": {
      "file": "config",
      "key": "frame_time_ns",
      "label": "F8 > Target FPS",
      "type": "int",
      "values": {
        "0": "Uncapped (VSync off)",
        "33333333": "30",
        "16666666": "60",
        "13333333": "75",
        "11111111": "90",
        "8333333": "120",
        "6944444": "144",
        "6666666": "150",
        "4166666": "240"
      },
      "default": "16666666",
      "per_game": false,
      "verified_on_device": true,
      "notes": "Nanoseconds per frame = 1e9 / fps (integer division). Presets {0,30,60,75,90,120,144,150,240}. With decouple_render on, the game logic stays at 60 Hz whatever the cap (Port_Config_TickTimeNs); 0 also disables VSync."
    },
