{
  "name": "tmc",
  "package": "dev.picori.tmc",
  "aliases": [
    "minish-cap",
    "minishcap",
    "picori"
  ],
  "category": "recomp",
  "version_checked": "0.8.3",
  "stop_before_write": true,
  "files": {
    "config": {
      "path": "/sdcard/Android/data/dev.picori.tmc/files/config.json",
      "format": "json",
      "notes": "Port runtime config (port/port_runtime_config.cpp, nlohmann::json, dump(4)). Read at game start; kept in memory and rewritten in full on every setter (SaveConfig), so stop the app first. A key with the wrong JSON type falls back to its default; malformed JSON falls back to all defaults. TMCLauncherActivity reads second_screen_swap from this file before the game starts."
    }
  },
  "per_game": null,
  "keys": {
    "render_backend": {
      "file": "config",
      "key": "render_backend",
      "label": "F8 > Renderer",
      "type": "enum",
      "values": {
        "\"software\"": "SDL_Renderer (software composite; Android default)",
        "\"gpu\"": "SDL_GPU (shaders, CRT/LCD filters, .glslp)",
        "\"auto\"": "GPU, falling back to SDL_Renderer"
      },
      "default": "\"software\"",
      "per_game": false,
      "verified_on_device": true,
      "notes": "Restart needed. 'sw' is accepted as software. CRT/LCD filters and shader presets need gpu."
    },
    "gpu_raster": {
      "file": "config",
      "key": "gpu_raster",
      "label": "F8 > GPU rasterizer",
      "type": "bool",
      "values": {
        "false": "Off",
        "true": "On"
      },
      "default": "true",
      "per_game": false,
      "verified_on_device": true,
      "notes": "GPU PPU rasterizer with CPU fallback; no effect unless the GPU backend is active."
    },
    "gpu_raster_gles": {
      "file": "config",
      "key": "gpu_raster_gles",
      "label": "F8 > GPU rasterizer (GLES compute)",
      "type": "bool",
      "values": {
        "false": "Off",
        "true": "On"
      },
      "default": "false",
      "per_game": false,
      "verified_on_device": true,
      "notes": "Opt-in GLES compute rasterizer, used only when the Vulkan raster is unavailable."
    },
    "upscale_method": {
      "file": "config",
      "key": "upscale_method",
      "label": "F8 > Upscale",
      "type": "enum",
      "values": {
        "\"nearest\"": "nearest",
        "\"linear\"": "linear",
        "\"xbrz_nearest\"": "xBRZ sharp",
        "\"xbrz_linear\"": "xBRZ smooth"
      },
      "default": "\"nearest\"",
      "per_game": false,
      "verified_on_device": true,
      "notes": "Any unrecognised name selects xBRZ smooth (port_ppu.cpp)."
    },
    "internal_scale": {
      "file": "config",
      "key": "internal_scale",
      "label": "F8 > Internal scale",
      "type": "int",
      "values": {
        "1": "1x",
        "2": "2x",
        "3": "3x",
        "4": "4x",
        "5": "5x",
        "6": "6x",
        "7": "7x",
        "8": "8x",
        "9": "9x",
        "10": "10x"
      },
      "default": "1",
      "per_game": false,
      "verified_on_device": true,
      "notes": "1-10; out-of-range resets to 1. Only matters when a shader or the widescreen path resamples the image."
    },
    "shader_preset": {
