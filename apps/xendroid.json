 "category": "emulator",
 "version_checked": "0b11201",
 "stop_before_write": true,
 "files": {
  "config": {
   "path": "/sdcard/Android/data/xendroid.compose/files/compose/xenia-canary.config.toml",
   "format": "toml",
   "notes": "Global Xenia config: TOML, [Section] tables, 'key = value'. The core writes it with single-quoted strings (apu = 'aaudio') and no comments; raw values in this adapter are written the way the core stores them: TOML literal strings in single quotes ('vulkan'), bare numbers and true/false. Read by the native core at boot (Emulator.Config.open_config_file); the settings screen loads it, edits it through the native config handle and saves it whole. Created from default_config.toml if missing. Keys missing from the file use the core default (a file written by an older build lacks newer keys, e.g. guest_scheduler, apu_aaudio_buffer_bursts). The native core logs 'SaveConfig skipped: a per-game config overlay is active', i.e. it also saves this file itself; stop the app before editing."
  },
  "default_config": {
   "path": "/sdcard/Android/data/xendroid.compose/files/compose/default_config.toml",
   "format": "toml",
   "notes": "Commented template of every core option with defaults. Re-copied from the APK assets on every app start when it differs (Application.onCreate). Never edit; read it for key names, defaults and help text."
  },
  "datastore": {
   "path": "/data/data/xendroid.compose/files/datastore/xendroid_prefs.preferences_pb",
   "format": "other",
   "notes": "AndroidX DataStore (protobuf). App state only: game_dir_path = the chosen ROM folder. Not emulation settings."
  }
 },
 "per_game": {
  "path": "/sdcard/Android/data/xendroid.compose/files/compose/config/{game}.config.toml",
  "format": "toml",
  "game_id": "Xbox 360 title ID, 8 uppercase hex digits (e.g. 415607D2), shown on the game's Per-game settings screen (route per_game_settings/{titleId}) and logged as 'Saved game config for title {:08X}'. Also the folder names in assets/game-patches.",
  "create": true,
  "notes": "Sparse TOML with the same [Section] key = value layout as the global file, holding only overridden keys. The app writes it from its per-game screen (D3.c.f: the file is deleted when no overrides remain) and the native core loads it at boot of that title ('Loading game config', 'Applied N game config override(s)'), layered over the global file; while it is active the core does not save the global file. Only keys in the app's settings list are offered per game (vulkan_lib_path and HID/vibration are not). Creating the config/ folder and the file by hand matches what the app does."
 },
