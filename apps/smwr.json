  "version_checked": "1.0.0",
  "stop_before_write": true,
  "files": {
    "settings": {
      "path": "/data/data/com.example.supermarioworldremasteredplus/files/settings.cfg",
      "format": "json",
      "notes": "Godot user://settings.cfg, JSON despite the extension (SettingsManager.gd: JSON.stringify with tab indent). Created on first launch; on every launch the game reads it, adds missing keys from its template and writes it back (verify_settings), and it rewrites it when options change, so stop the app first. Godot parses all JSON numbers as floats, so after the first rewrite integers appear as 0.0 / 1.0; both forms work. resolution is stored as a string like \"(1440, 810)\". Template {} is safe: the game fills in every missing key (not tested).",
      "template": "{}\n"
    }
  },
  "per_game": null,
  "keys": {
    "window_type": {
      "file": "settings",
      "key": "window_type",
      "label": "Display > Window Type",
      "type": "int",
      "values": {
        "0": "Windowed",
        "1": "Borderless",
        "2": "Fullscreen"
      },
      "default": "0",
      "per_game": false,
      "verified_on_device": false,
      "notes": "On Android set Fullscreen (2): Windowed leaves the status and navigation bars over the game (BTFighter v1.1 release notes)."
    },
    "resolution": {
      "file": "settings",
      "key": "resolution",
      "label": "Display > Window Resolution",
      "type": "enum",
      "values": {
        "\"(480, 270)\"": "480x270",
        "\"(960, 540)\"": "960x540",
        "\"(1440, 810)\"": "1440x810",
        "\"(1920, 1080)\"": "1920x1080",
        "\"(2560, 1440)\"": "2560x1440",
        "\"(3840, 2160)\"": "3840x2160"
      },
      "default": "\"(1440, 810)\"",
      "per_game": false,
      "verified_on_device": false,
      "notes": "Window size; with Fullscreen on Android the window fills the panel anyway. Parsed by stripping '(', ')' and spaces, so decimals like (1440.0, 810.0) also work."
    },
