 "stop_before_write": true,
 "files": {
  "config": {
   "path": "/sdcard/Documents/pico8/data/config.txt",
   "format": "spaced",
   "notes": "PICO-8 0.2.7 (Raspberry Pi build, pico8_64) config. Format: one setting per line, 'key value' separated by a space, values are bare numbers or words (multi-number values space-separated, e.g. 'window_size 128 128'); text after '//' is a comment; '//' lines are comments. Keep the comment lines; edit the value token only. PICO-8 reads it at start and saves it on a clean exit; the wrapper kills pico8 with SIGKILL, so in practice it is not rewritten. Inside the proot it is /home/public/data/config.txt (-home /home/public/data). The wrapper's command line overrides window_size/screen_size/windowed (-width 128 -height 128 -windowed 1), root_path (-root_path) and boot_to_splore (-splore), so those keys have no effect. Owner u0_a<N>:media_rw (shared storage)."
  },
  "wrapper": {
   "path": "/data/data/io.wip.pico8/files/settings.cfg",
   "format": "ini",
   "notes": "Godot ConfigFile (user://settings.cfg) of the Android wrapper (Macs75/pico8-android). Format: '[section]' headers, 'key=value' lines with Godot Variant literals: ints 3, floats 1.0, bools true/false, strings \"sles\", Color(r, g, b, a). Settings are in [settings]; [updates] holds last_check. Only keys changed in the menu are present: missing = default. The app caches the file in memory and rewrites it whole on every option change, so force-stop first. Root only, owner u0_a<N>, mode 600."
  },
  "stats": {
   "path": "/data/data/io.wip.pico8/files/activity_stats.json",
   "format": "json",
   "notes": "Play counts and time per cart. Not settings."
  }
 },
