  ],
  "category": "recomp",
  "version_checked": "1.5.3",
  "stop_before_write": true,
  "files": {
    "config": {
      "path": "/data/data/com.companyname.AM2RWrapper/files/config.ini",
      "format": "ini",
      "notes": "GameMaker ini (load_gameoptions.gml / save_gameoptions.gml). `Key=\"<real>\"`: no spaces, every value a double-quoted real with six decimals, e.g. Widescreen=\"1.000000\". Raw values below include the quotes. Read when the game starts (oControl) and rewritten in full by the Options menus. Private app storage (root); owned by the app uid, mode 600: keep owner and mode when writing. Game data string says V1.5.5; source used is AM2R-Community-Updates HEAD."
    }
  },
  "per_game": null,
  "keys": {
    "widescreen": {
      "file": "config",
      "key": "Screen/Widescreen",
      "label": "Display > Widescreen",
      "type": "enum",
      "values": {
        "\"0.000000\"": "Off",
        "\"1.000000\"": "On"
      },
      "default": "\"1.000000\"",
      "per_game": false,
      "verified_on_device": true,
      "notes": "Needs a room transition to take effect in game."
    },
