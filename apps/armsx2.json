{
 "name": "armsx2",
 "package": "com.armsx2",
 "aliases": [
  "ps2"
 ],
 "version_checked": "2.9.7",
 "stop_before_write": true,
 "files": {
  "prefs": {
   "path": "/data/data/com.armsx2/shared_prefs/ARMSX2.xml",
   "format": "prefs",
   "notes": "Source of truth for every emulator setting. Global settings are one JSON object in <string name=\"config.global\">; per-game overrides are sparse JSON objects in <string name=\"config.game.<serial>\">. Keys here use the '#'-JSON-path convention (config.global#renderer). Raw values are JSON scalars: true, 2, 1.5, \"vulkan\". App-only prefs (touch.*, ui.osdMode, bios, systemDir, romsDirs, playtime.*) sit beside them. Mode 660; keep the file's owner (the app uid), mode and SELinux label (u:object_r:app_data_file with the app's categories) when writing."
  },
  "core_ini": {
   "path": "/storage/{sdcard}/Android/data/com.armsx2/files/PCSX2-Android.ini",
   "format": "ini",
   "notes": "PCSX2 base settings layer read by the native core. REGENERATED by the app from the resolved prefs (global merged with the launching game's overrides) at every game boot and on each settings save, so it holds whatever the last game ran with. Do not edit; edits are overwritten. Read-only use: see what the last session actually ran (e.g. EmuCore/GS/Renderer = 14 = Vulkan). Location = prefs systemDir (can be on the SD card)."
  },
  "mirror": {
   "path": "/storage/{sdcard}/Android/data/com.armsx2/files/armsx2-settings.json",
   "format": "json",
   "notes": "Backup mirror {global:{...}, games:{<serial>:{...}}} written on every app-side save. Read back ONLY when config.global is missing from prefs (fresh install reusing the folder). Not read otherwise; editing it has no effect while prefs exist. It goes stale after a direct prefs edit until the app next saves."
  }
 },
 "per_game": {
  "path": "/data/data/com.armsx2/shared_prefs/ARMSX2.xml",
  "format": "prefs",
  "game_id": "The disc serial as shown in ARMSX2 (e.g. SCUS-97265), from gamesCache[].serial in ARMSX2.xml, the game's PCSX2 GameDB entry, or the gamesettings/<SERIAL>_<CRC>.ini filename. Serial-less ELF/homebrew use the ROM filename stem.",
  "create": true,
  "notes": "Per-game settings are the pref string config.game.{game}: a SPARSE JSON object holding only the overridden keys, using the same key names as config.global. So a glossary key config.global#X becomes config.game.{game}#X for a game (the key prefix changes; the file does not). Create the <string name=\"config.game.{game}\"> entry with {} if it does not exist. Merge at boot: per-game key if present, else global, else code default. Removing a key (or the whole entry) returns that setting to global. The app regenerates gamesettings/<SERIAL>_<CRC>.ini from this at boot; do not edit those INIs.",
  "key_map": {
   "from": "config.global#",
   "to": "config.game.{game}#"
  }
 },
