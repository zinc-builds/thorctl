  "system": {
   "path": "/sdcard/Android/data/com.opende.deusex/files/DeusEx.ini",
   "format": "ini",
   "notes": "User copy of the system ini (config.cc userDirectory = app external files dir; created from the game's System/DeusEx.ini or Default.ini). `Key=Value` without spaces; repeated keys (Paths=, ServerActors=, EditPackages=) are lists: edit only single-valued keys. OpenDE-specific options are stored as menu indices in [WinDrv.WindowsClient] (the ViewportManager section). OpenDE writes the file when settings change in its menus (Ini::save), so stop the app first. The DeusEx.ini inside <game_root>/System (game_root in opende_prefs.xml) is NOT the live one."
  },
  "user": {
   "path": "/sdcard/Android/data/com.opende.deusex/files/User.ini",
   "format": "ini",
   "notes": "User copy of User.ini: [DeusEx.DeusExPlayer] HUD/gameplay toggles, [Engine.Input] key bindings and aliases."
  }
